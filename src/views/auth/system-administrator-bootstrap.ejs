<% /* View locals supplied by the page router. */ /* global bootstrapCssUrl, bootstrapCssIntegrity, appCssUrl, administrativeLoginUrl, systemAdministratorBootstrapJsUrl, accountFormsJsUrl */ %><!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>System Administrator Bootstrap | Training Management System</title>
  <link href="<%= bootstrapCssUrl %>" rel="stylesheet" integrity="<%= bootstrapCssIntegrity %>" crossorigin="anonymous">
  <link href="<%= appCssUrl %>" rel="stylesheet">
</head>
<body class="bg-light" data-admin-login-url="<%= administrativeLoginUrl %>">
<main class="container py-5">
  <div class="row justify-content-center"><div class="col-12 col-md-8 col-lg-6">
    <div class="card shadow-sm"><div class="card-body p-4">
      <h1 class="h4 mb-4">System Administrator Initial Setup</h1>
      <div id="pageMessage" class="alert d-none" role="alert" aria-live="polite"></div>
      <form id="systemAdminBootstrapForm" novalidate>
        <div class="mb-3"><label class="form-label" for="staticAdministrationKey">Static Administration Key *</label>
          <input class="form-control" type="password" id="staticAdministrationKey" name="staticAdministrationKey" autocomplete="off" required></div>
        <div class="mb-3"><label class="form-label" for="username">Username *</label>
          <input class="form-control" id="username" name="username" maxlength="100" autocomplete="username" required></div>
        <div class="mb-3"><label class="form-label" for="name">Name *</label>
          <input class="form-control" id="name" name="name" maxlength="200" autocomplete="name" required></div>
        <div class="mb-3"><label class="form-label" for="email">Email *</label>
          <input class="form-control" type="email" id="email" name="email" maxlength="254" autocomplete="email" required></div>
        <div class="mb-4"><label class="form-label" for="password">Password *</label>
          <input class="form-control" type="password" id="password" name="password" minlength="12" autocomplete="new-password" aria-describedby="passwordHelp" required>
          <div id="passwordHelp" class="form-text">Minimum 12 characters with uppercase, lowercase, digit and non-alphanumeric character.</div>
          <div class="invalid-feedback">Password does not meet the required policy.</div></div>
        <button id="submitButton" class="btn btn-primary w-100" type="submit">Create System Administrator</button>
      </form>
    </div></div>
  </div></div>
</main>
<script src="<%= accountFormsJsUrl %>" defer></script>
<script src="<%= systemAdministratorBootstrapJsUrl %>" defer></script>
</body>
</html>
