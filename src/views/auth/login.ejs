<%- include('../partials/head', {title: 'Login'}) %>
<main id="mainContent" class="container py-5" tabindex="-1"><div class="row justify-content-center"><section class="col-12 col-md-8 col-lg-5 card card-body">
<h1 class="h3">Login</h1><div id="pageMessage" class="alert d-none" role="alert" tabindex="-1"></div>
<form id="loginForm" novalidate>
<div class="mb-3"><label class="form-label" for="accountType">Account Type</label><select id="accountType" class="form-select" required><option value="participant">Participant</option><option value="staff">Staff</option><option value="system-admin">System Administrator</option></select></div>
<div class="mb-3"><label class="form-label" for="email">Email</label><input id="email" name="email" type="email" class="form-control" maxlength="254" autocomplete="username" required aria-describedby="emailError"><div id="emailError" class="invalid-feedback">Enter a valid email address.</div></div>
<div class="mb-3"><label class="form-label" for="password">Password</label><input id="password" name="password" type="password" class="form-control" autocomplete="current-password" required aria-describedby="passwordError"><div id="passwordError" class="invalid-feedback">Password is required.</div></div>
<button id="loginButton" class="btn btn-primary w-100" type="submit">Login</button>
</form><a class="mt-3" href="<%= participantRegistrationUrl %>">Create Participant Account</a>
</section></div></main><script src="/js/login.js" defer></script><%- include('../partials/footer') %></body></html>
