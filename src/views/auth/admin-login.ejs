<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Administrative Login | Training Management System</title>
  <link href="<%= bootstrapCssUrl %>" rel="stylesheet" integrity="<%= bootstrapCssIntegrity %>" crossorigin="anonymous">
  <link href="<%= appCssUrl %>" rel="stylesheet">
</head>
<body class="bg-light" data-workflow="<%= workflow %>" <% if (workflow === "WF-006") { %>data-training-administrator-url="<%= trainingAdministratorLandingUrl %>" data-trainer-url="<%= trainerLandingUrl %>"<% } else { %>data-success-url="<%= adminLandingUrl %>"<% } %>>
<main class="container py-4">
  <div class="row justify-content-center"><div class="col-12 col-md-6 col-lg-5">
    <div class="card shadow-sm"><div class="card-body p-4">
      <h1 class="h4 mb-4"><%= workflow === "WF-006" ? "Staff Login" : "System Administrator Login" %></h1>
      <div id="pageMessage" class="alert d-none" role="alert" aria-live="polite"></div>
      <form id="loginForm" novalidate>
        <div class="mb-3">
          <label for="email" class="form-label">Email Address *</label>
          <input id="email" name="email" type="email" class="form-control" maxlength="254" autocomplete="username" required>
          <div class="invalid-feedback">Enter a valid email address.</div>
        </div>
        <div class="mb-3">
          <label for="password" class="form-label">Password *</label>
          <input id="password" name="password" type="password" class="form-control" autocomplete="current-password" required>
          <div class="invalid-feedback">Password is required.</div>
        </div>
        <div class="d-grid"><button id="loginButton" class="btn btn-primary" type="submit">Login</button></div>
      </form>
    </div></div>
  </div></div>
</main>
<script src="<%= workflow === "WF-006" ? staffLoginJsUrl : systemAdministratorLoginJsUrl %>" defer></script>
</body>
</html>
