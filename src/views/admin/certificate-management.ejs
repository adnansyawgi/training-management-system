<% /* View locals supplied by the page router. */ /* global csrfToken, bootstrapCssUrl, bootstrapCssIntegrity, appCssUrl, certificateManagementJsUrl, selected, certificateManagementUrl, trainingAdministratorLandingUrl, registrationManagementUrl, reportsUrl, programs, programPage, link, programTotal, eligibleRegistrations, page, total */ %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="csrf-token" content="<%= csrfToken %>"><title>Certificate management</title><link rel="stylesheet" href="<%= bootstrapCssUrl %>" integrity="<%= bootstrapCssIntegrity %>" crossorigin="anonymous"><link rel="stylesheet" href="<%= appCssUrl %>"><script defer src="<%= certificateManagementJsUrl %>"></script></head>
<body data-program-id="<%= selected?.programId ?? '' %>" data-page-url="<%= certificateManagementUrl %>" data-cancel-url="<%= trainingAdministratorLandingUrl %>">
<%- include('../partials/header') %><main id="mainContent" tabindex="-1" class="container py-4"><nav><a href="<%= trainingAdministratorLandingUrl %>">Programs</a> &middot; <a href="<%= registrationManagementUrl %>">Registrations</a> &middot; <a href="<%= reportsUrl %>">Reports</a></nav><h1>Certificate management</h1><div id="pageMessage" class="alert d-none" role="status" aria-live="polite"></div>
<form id="certificateForm"><label for="programId">Program</label><select id="programId" class="form-select mb-3" required><option value="">Select program</option><% for(const program of programs){ %><option value="<%= program.programId %>" <%= selected?.programId===program.programId?'selected':'' %>><%= program.code %> — <%= program.name %></option><% } %></select>
<% if(programPage>1){ %><a href="<%= link({programPage:programPage-1}) %>">Previous programs</a><% } %><% if(programPage*100<programTotal){ %><a href="<%= link({programPage:programPage+1}) %>">More programs</a><% } %>
<label for="registrationId">Eligible registration</label><select name="registrationId" id="registrationId" class="form-select mb-3" required><option value="">Select registration</option><% for(const row of eligibleRegistrations){ %><option value="<%= row.registrationId %>" data-completion-date="<%= row.completionDate %>"><%= row.referenceNo %> — <%= row.participantName %></option><% } %></select>
<% if(!eligibleRegistrations.length){ %><p>No eligible registrations on this page.</p><% } %>
<label for="completionDate">Completion date (server-derived)</label><input id="completionDate" class="form-control mb-3" readonly>
<% for(const [name,label,max,required] of [['certificateType','Certificate type',100,true],['certificateTitle','Certificate title',255,true],['issuingAuthority','Issuing authority',255,false],['verificationReference','Verification reference',255,false],['documentReference','Document reference',500,false]]){ %><label for="<%= name %>"><%= label %></label><input class="form-control mb-3" id="<%= name %>" name="<%= name %>" maxlength="<%= max %>" <% if(required){ %>required<% } %>><% } %>
<button type="submit" id="issueCertificate" class="btn btn-primary" <%= eligibleRegistrations.length?'':'disabled' %>>Record certificate issuance</button> <button type="button" id="cancelCertificate" class="btn btn-outline-secondary">Cancel</button></form>
<nav class="mt-3" aria-label="Eligible registration pages"><% if(page>1){ %><a href="<%= link({page:page-1}) %>">Previous registrations</a><% } %> Page <%= page %> <% if(page*100<total){ %><a href="<%= link({page:page+1}) %>">More registrations</a><% } %></nav>
<p class="mt-3">This release records issuance with an opaque technical reference. Completion date, attendance, eligibility and issuance authority are server-derived. PDF generation, templates, signatory details and business-facing numbering remain deferred.</p></main><%- include('../partials/footer') %></body></html>
