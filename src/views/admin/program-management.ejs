<% /* View locals supplied by the page router. */ /* global csrfToken, bootstrapCssUrl, bootstrapCssIntegrity, appCssUrl, businessTimeJsUrl, programManagementJsUrl, trainingAdministratorLandingUrl, categoryManagementUrl, registrationManagementUrl, certificateManagementUrl, reportsUrl, records, link, page, pageSize, total, editing, businessTimezone, categories, categoryPage, categoryTotal, trainers, trainerPage, trainerTotal, localDateTime */ %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="csrf-token" content="<%= csrfToken %>"><title>Manage training programs</title><link rel="stylesheet" href="<%= bootstrapCssUrl %>" integrity="<%= bootstrapCssIntegrity %>" crossorigin="anonymous"><link rel="stylesheet" href="<%= appCssUrl %>"><script defer src="<%= businessTimeJsUrl %>"></script><script defer src="<%= programManagementJsUrl %>"></script></head><body>
<%- include('../partials/header') %><main id="mainContent" tabindex="-1" class="container py-4">
<nav><a href="<%= trainingAdministratorLandingUrl %>">Programs</a> · <a href="<%= categoryManagementUrl %>">Categories</a> &middot; <a href="<%= registrationManagementUrl %>">Registrations</a> &middot; <a href="<%= certificateManagementUrl %>">Certificates</a> &middot; <a href="<%= reportsUrl %>">Reports</a></nav><h1>Manage training programs</h1>
<div class="table-responsive"><table class="table"><thead><tr><th>Code</th><th>Name</th><th>Date</th><th>Status</th><th>Action</th></tr></thead><tbody><% for(const item of records){ %><tr><td><%= item.code %></td><td><%= item.name %></td><td><%= item.trainingDate %></td><td><%= item.status %></td><td><a href="<%= link({edit:item.programId}) %>">Edit</a></td></tr><% } %></tbody></table></div>
<% if(page>1){ %><a href="<%= link({page:page-1}) %>">Previous</a><% } %> Page <%= page %> <% if(page*pageSize<total){ %><a href="<%= link({page:page+1}) %>">Next</a><% } %>
<h2 class="mt-4"><%= editing?'Edit program':'Create program' %></h2><p>Schedule and registration window inputs use <%= businessTimezone %>.</p><a href="<%= trainingAdministratorLandingUrl %>">New program / cancel editing</a>
<div id="management-message" role="status" aria-live="polite"></div>
<form id="management-form" data-kind="programs" data-timezone="<%= businessTimezone %>"><input type="hidden" name="recordId" value="<%= editing?.programId || '' %>">
<% const value=key=>editing?.[key] ?? ''; const input=(name,label,type,max=null,required=true)=>{ %><div class="mb-3"><label class="form-label" for="<%= name %>"><%= label %></label><input class="form-control" id="<%= name %>" name="<%= name %>" type="<%= type %>" value="<%= value(name) %>" <% if(max){ %>maxlength="<%= max %>"<% } %> <% if(required){ %>required<% } %> <% if(name==='code'&&editing){ %>readonly<% } %> <% if(type==='time'){ %>step="1"<% } %>></div><% }; %>
<% input('code','Code','text',50);input('name','Name','text',200); %>
<% for(const [name,label,max,required] of [['description','Description',65535,true],['objectives','Objectives',65535,true],['targetAudience','Target audience',500,true],['prerequisites','Prerequisites',1000,false]]){ %><div class="mb-3"><label for="<%= name %>"><%= label %></label><textarea class="form-control" id="<%= name %>" name="<%= name %>" maxlength="<%= max %>" <% if(required){ %>required<% } %>><%= value(name) %></textarea></div><% } %>
<label for="categoryId">Category</label><select class="form-select mb-3" id="categoryId" name="categoryId" required><option value="">Select category</option><% if(editing&&!categories.some(c=>c.categoryId===editing.categoryId)){ %><option selected value="<%= editing.categoryId %>"><%= editing.categoryName %> (current)</option><% } %><% for(const item of categories){ %><option value="<%= item.categoryId %>" <%= value('categoryId')===item.categoryId?'selected':'' %>><%= item.name %> (<%= item.status %>)</option><% } %></select>
<% if(categoryPage>1){ %><a href="<%= link({categoryPage:categoryPage-1}) %>">Previous categories</a><% } %><% if(categoryPage*100<categoryTotal){ %><a href="<%= link({categoryPage:categoryPage+1}) %>">More categories</a><% } %>
<label for="trainerUserId">Active trainer</label><select class="form-select mb-3" id="trainerUserId" name="trainerUserId" required><option value="">Select trainer</option><% if(editing&&!trainers.some(t=>t.userId===editing.trainerUserId)){ %><option selected value="<%= editing.trainerUserId %>"><%= editing.trainerName %> (current; active status checked on save)</option><% } %><% for(const item of trainers){ %><option value="<%= item.userId %>" <%= value('trainerUserId')===item.userId?'selected':'' %>><%= item.name %></option><% } %></select>
<% if(trainerPage>1){ %><a href="<%= link({trainerPage:trainerPage-1}) %>">Previous trainers</a><% } %><% if(trainerPage*100<trainerTotal){ %><a href="<%= link({trainerPage:trainerPage+1}) %>">More trainers</a><% } %>
<% input('trainingDate','Training date','date');input('startTime','Start time','time');input('endTime','End time','time');input('venue','Venue','text',300,false);input('deliveryMode','Delivery mode','text',50); %>
<label for="capacity">Capacity</label><input class="form-control mb-3" id="capacity" name="capacity" type="number" min="1" max="2147483647" step="1" required value="<%= editing?.capacity ?? 20 %>">
<% for(const [name,label] of [['registrationOpenAt','Registration opens'],['registrationCloseAt','Registration closes']]){ %><label for="<%= name %>"><%= label %></label><input class="form-control mb-3" id="<%= name %>" name="<%= name %>" type="datetime-local" step="1" required value="<%= editing?localDateTime(value(name)):'' %>"><% } %>
<label for="status">Status</label><select class="form-select mb-3" id="status" name="status"><% for(const status of ['DRAFT','OPEN','CLOSED','COMPLETED','CANCELLED']){ %><option <%= value('status')===status?'selected':'' %>><%= status %></option><% } %></select>
<% input('cancellationPolicyReference','Cancellation policy reference','text',255,false);input('certificateEligibilityCriteria','Certificate eligibility criteria','text',100);input('certificateType','Certificate type','text',100,false); %>
<button class="btn btn-primary" type="submit">Save program</button></form></main><%- include('../partials/footer') %></body></html>
