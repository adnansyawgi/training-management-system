<% /* View locals supplied by the page router. */ /* global bootstrapCssUrl, bootstrapCssIntegrity, appCssUrl, businessTimeJsUrl, reportsJsUrl, businessTimezone, trainingAdministratorLandingUrl, registrationManagementUrl, certificateManagementUrl, definitions */ %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Reports</title><link rel="stylesheet" href="<%= bootstrapCssUrl %>" integrity="<%= bootstrapCssIntegrity %>" crossorigin="anonymous"><link rel="stylesheet" href="<%= appCssUrl %>"><script defer src="<%= businessTimeJsUrl %>"></script><script defer src="<%= reportsJsUrl %>"></script></head>
<body data-timezone="<%= businessTimezone %>">
<%- include('../partials/header') %><main id="mainContent" tabindex="-1" class="container py-4"><nav><a href="<%= trainingAdministratorLandingUrl %>">Programs</a> &middot; <a href="<%= registrationManagementUrl %>">Registrations</a> &middot; <a href="<%= certificateManagementUrl %>">Certificates</a></nav><h1>Reports</h1><div id="pageMessage" class="alert d-none" role="status" aria-live="polite"></div><p>Period inputs use <%= businessTimezone %>. From is inclusive; To is exclusive. CSV exports the requested page, up to 100 rows.</p>
<form id="reportForm" class="row g-3"><div class="col-md-4"><label for="reportType">Report type</label><select id="reportType" class="form-select"><% for(const [key,definition] of Object.entries(definitions)){ %><option value="<%= key %>"><%= definition.name %></option><% } %></select></div>
<% for(const [name,label] of [['periodFrom','Period From'],['periodTo','Period To']]){ %><div class="col-md-4"><label for="<%= name %>"><%= label %></label><input type="datetime-local" step="1" required id="<%= name %>" class="form-control"></div><% } %>
<% for(const type of ['certificates','registrations','accounts']){ %><fieldset data-report-filters="<%= type %>" class="row g-3"><legend class="h6">Filters</legend>
<% for(const [key,label] of (type==='accounts'?[['participantId','Student ID']]:[['programId','Program ID'],['categoryId','Category ID'],['participantId','Student ID']])){ %><div class="col-md-3"><label for="<%= type %>-<%= key %>"><%= label %></label><input data-filter="<%= key %>" type="number" step="1" min="1" max="9007199254740991" id="<%= type %>-<%= key %>" class="form-control"></div><% } %>
<% const statusKey=type==='certificates'?'certificateStatus':type==='registrations'?'status':'accountStatus';const statuses=type==='certificates'?['ISSUED']:type==='registrations'?['REGISTERED','CANCELLED']:['ACTIVE','INACTIVE','LOCKED','DISABLED']; %><div class="col-md-3"><label for="<%= type %>-status">Status</label><select data-filter="<%= statusKey %>" id="<%= type %>-status" class="form-select"><option value="">All</option><% for(const status of statuses){ %><option><%= status %></option><% } %></select></div></fieldset><% } %>
<div class="col-md-3"><label for="pageSize">Rows per page</label><input id="pageSize" type="number" min="1" max="100" step="1" required value="20" class="form-control"></div><div class="col-md-9 d-flex align-items-end"><button type="submit" id="generateReport" class="btn btn-primary">Generate Report</button></div></form>
<hr><div id="reportMeta" aria-live="polite"></div><div class="table-responsive"><table class="table table-sm"><thead id="reportHead"></thead><tbody id="reportBody"></tbody></table></div><p id="emptyState" class="d-none">No records match this report.</p><div class="d-flex justify-content-between"><div><button type="button" id="prevReport" class="btn btn-outline-secondary" disabled>Previous</button> <button type="button" id="nextReport" class="btn btn-outline-secondary" disabled>Next</button></div><button type="button" id="exportCsv" class="btn btn-outline-primary" disabled>Export CSV</button></div>
<p class="mt-3">Only the three approved reports are available. Account Created By requires verified creation audits. NRIC/Passport is omitted from these fixed columns.</p>
<div id="reportColumns" hidden><% for(const [type,definition] of Object.entries(definitions)){ %><div data-report="<%= type %>"><% for(const [label,key] of definition.columns){ %><span data-key="<%= key %>"><%= label %></span><% } %></div><% } %></div></main><%- include('../partials/footer') %></body></html>
