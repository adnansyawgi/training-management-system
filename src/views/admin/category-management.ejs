<% /* View locals supplied by the page router. */ /* global csrfToken, bootstrapCssUrl, bootstrapCssIntegrity, appCssUrl, programManagementJsUrl, trainingAdministratorLandingUrl, categoryManagementUrl, registrationManagementUrl, certificateManagementUrl, reportsUrl, records, link, page, pageSize, total, editing */ %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="csrf-token" content="<%= csrfToken %>"><title>Manage categories</title><link rel="stylesheet" href="<%= bootstrapCssUrl %>" integrity="<%= bootstrapCssIntegrity %>" crossorigin="anonymous"><link rel="stylesheet" href="<%= appCssUrl %>"><script defer src="<%= programManagementJsUrl %>"></script></head><body><main class="container py-4"><nav><a href="<%= trainingAdministratorLandingUrl %>">Programs</a> · <a href="<%= categoryManagementUrl %>">Categories</a> &middot; <a href="<%= registrationManagementUrl %>">Registrations</a> &middot; <a href="<%= certificateManagementUrl %>">Certificates</a> &middot; <a href="<%= reportsUrl %>">Reports</a></nav><h1>Manage categories</h1>
<table class="table"><thead><tr><th>Name</th><th>Description</th><th>Status</th><th>Action</th></tr></thead><tbody><% for(const item of records){ %><tr><td><%= item.name %></td><td><%= item.description ?? '' %></td><td><%= item.status %></td><td><a href="<%= link({edit:item.categoryId}) %>">Edit</a></td></tr><% } %></tbody></table>
<% if(page>1){ %><a href="<%= link({page:page-1}) %>">Previous</a><% } %> Page <%= page %> <% if(page*pageSize<total){ %><a href="<%= link({page:page+1}) %>">Next</a><% } %>
<h2><%= editing?'Edit category':'Create category' %></h2><a href="<%= categoryManagementUrl %>">New category / cancel editing</a><div id="management-message" role="status" aria-live="polite"></div>
<form id="management-form" data-kind="categories"><input name="recordId" type="hidden" value="<%= editing?.categoryId || '' %>"><label for="name">Name</label><input class="form-control mb-3" name="name" id="name" required maxlength="150" value="<%= editing?.name || '' %>"><label for="description">Description</label><textarea class="form-control mb-3" name="description" id="description" maxlength="500"><%= editing?.description || '' %></textarea><label for="status">Status</label><select class="form-select mb-3" name="status" id="status"><% for(const status of ['ACTIVE','INACTIVE']){ %><option <%= editing?.status===status?'selected':'' %>><%= status %></option><% } %></select><button type="submit" class="btn btn-primary">Save category</button></form></main></body></html>
