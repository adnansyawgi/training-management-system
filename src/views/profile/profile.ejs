<%- include('../partials/head', {title: 'Profile'}) %>
<main id="mainContent" class="container py-4" tabindex="-1"><div class="row justify-content-center"><section class="col-12 col-lg-8">
<h1>Profile</h1><p>Your identifiers and identity information are read-only.</p><dl class="row">
<% const labels = {userId:'User ID', accountIdentifier:'Account Identifier', role:'Role', participantId:'Participant ID', nricPassportNo:'NRIC / Passport (masked)', name:'Name', username:'Username', accountStatus:'Account Status'};
const values = {...ownProfile, ...ownProfile.profile};
Object.entries(labels).forEach(([key,label]) => { if (Object.hasOwn(values,key)) { %><dt class="col-sm-4"><%= label %></dt><dd class="col-sm-8 text-break"><%= values[key] %></dd><% } }); %></dl>
<div id="profileMessage" class="alert d-none" role="alert" tabindex="-1"></div>
<form id="profileForm" novalidate>
<% ownProfile.editableFields.forEach(key => { const email = key === 'email'; %>
<div class="mb-3"><label class="form-label" for="<%= key %>"><%= email ? 'Email' : 'Mobile Number' %></label>
<input class="form-control" id="<%= key %>" name="<%= key %>" type="<%= email ? 'email' : 'tel' %>" maxlength="<%= email ? 254 : 30 %>" autocomplete="<%= email ? 'email' : 'tel' %>" value="<%= ownProfile.profile[key] %>" required aria-describedby="<%= key %>Error">
<div class="invalid-feedback" id="<%= key %>Error"><%= email ? 'Enter a valid email address.' : 'Mobile Number is required and must not exceed 30 characters.' %></div></div><% }); %>
<button id="saveProfile" class="btn btn-primary" type="submit">Save Profile</button>
</form><a class="d-inline-block mt-3" href="<%= dashboardUrl %>">Back to Dashboard</a>
</section></div></main><script src="/js/profile.js" defer></script><%- include('../partials/footer') %></body></html>
