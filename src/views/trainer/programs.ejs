<% /* View locals supplied by the page router. */ /* global bootstrapCssUrl, bootstrapCssIntegrity, appCssUrl, programs, trainerLandingUrl, page, total */ %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Assigned programs</title><link rel="stylesheet" href="<%= bootstrapCssUrl %>" integrity="<%= bootstrapCssIntegrity %>" crossorigin="anonymous"><link rel="stylesheet" href="<%= appCssUrl %>"></head><body>
<%- include('../partials/header') %><main id="mainContent" tabindex="-1" class="container py-4"><h1>Assigned programs</h1><div class="table-responsive"><table class="table"><thead><tr><th>Code</th><th>Name</th><th>Date</th><th>Action</th></tr></thead><tbody><% for(const program of programs){ %><tr><td><%= program.code %></td><td><%= program.name %></td><td><%= program.trainingDate %></td><td><a href="<%= trainerLandingUrl %>/<%= program.programId %>/attendance">Record attendance</a></td></tr><% } %></tbody></table></div><% if(!programs.length){ %><p>No assigned programs on this page.</p><% } %><% if(page>1){ %><a href="<%= trainerLandingUrl %>?page=<%= page-1 %>">Previous</a><% } %> Page <%= page %> <% if(page*100<total){ %><a href="<%= trainerLandingUrl %>?page=<%= page+1 %>">Next</a><% } %></main><%- include('../partials/footer') %></body></html>
