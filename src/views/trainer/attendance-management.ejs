<% /* View locals supplied by the page router. */ /* global csrfToken, bootstrapCssUrl, bootstrapCssIntegrity, appCssUrl, businessTimeJsUrl, attendanceManagementJsUrl, businessTimezone, program, trainerLandingUrl, assignedPrograms, records, localInput, page, total */ %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="csrf-token" content="<%= csrfToken %>"><title>Record attendance</title><link rel="stylesheet" href="<%= bootstrapCssUrl %>" integrity="<%= bootstrapCssIntegrity %>" crossorigin="anonymous"><link rel="stylesheet" href="<%= appCssUrl %>"><script defer src="<%= businessTimeJsUrl %>"></script><script defer src="<%= attendanceManagementJsUrl %>"></script></head>
<body data-timezone="<%= businessTimezone %>" data-program-id="<%= program.programId %>"><main class="container py-4"><a href="<%= trainerLandingUrl %>">Assigned programs</a><h1>Record attendance</h1><div id="pageMessage" class="alert d-none" role="status" aria-live="polite"></div>
<label for="programId">Assigned program</label><select class="form-select mb-3" id="programId"><% for(const item of assignedPrograms){ %><option value="<%= item.programId %>" <%= item.programId===program.programId?'selected':'' %>><%= item.code %> — <%= item.name %></option><% } %></select>
<p>Check-in/out inputs use <%= businessTimezone %>. Saving updates the records on this page.</p>
<form id="attendanceForm"><label for="attendanceDate">Attendance date</label><input class="form-control mb-3" id="attendanceDate" name="attendanceDate" type="date" required>
<div class="table-responsive"><table class="table"><thead><tr><th>Reference</th><th>Participant</th><th>Existing date</th><th>Status</th><th>Optional details</th></tr></thead><tbody>
<% for(const row of records){ %><tr data-registration-id="<%= row.registrationId %>"><td><%= row.referenceNo %></td><td><%= row.participantName %></td><td><%= row.attendanceDate ?? '' %></td><td><label class="visually-hidden" for="status-<%= row.registrationId %>">Attendance status for <%= row.referenceNo %></label><select id="status-<%= row.registrationId %>" class="form-select attendance-status" required><option value="">Select</option><% for(const status of ['PRESENT','ABSENT']){ %><option <%= row.status===status?'selected':'' %>><%= status %></option><% } %></select></td><td>
<% for(const [key,label,max] of [['checkInAt','Check in',null],['checkOutAt','Check out',null],['verificationMethod','Verification method',50],['evidenceReference','Evidence reference',255],['remarks','Remarks',500]]){ %><label for="<%= key %>-<%= row.registrationId %>"><%= label %></label><input class="form-control mb-2" id="<%= key %>-<%= row.registrationId %>" data-field="<%= key %>" type="<%= max?'text':'datetime-local' %>" <% if(max){ %>maxlength="<%= max %>" <% }else{ %>step="1"<% } %> value="<%= max?(row[key] ?? ''):localInput(row[key]) %>"><% } %>
</td></tr><% } %></tbody></table></div>
<button type="submit" id="saveAttendance" class="btn btn-primary" <%= records.length?'':'disabled' %>>Save Attendance</button></form>
<% if(!records.length){ %><p>No REGISTERED participants on this page.</p><% } %><nav class="mt-3" aria-label="Roster pages"><% if(page>1){ %><a href="?page=<%= page-1 %>">Previous</a><% } %> Page <%= page %> <% if(page*100<total){ %><a href="?page=<%= page+1 %>">Next</a><% } %></nav></main></body></html>
