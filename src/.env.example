#MySQL configuration
PORT=3000
DB_HOST=localhost
DB_PORT=3307
DB_USER=appuser
DB_PASSWORD=app123
DB_NAME=appdb
DB_CONNECTION_LIMIT=10

# Participant role baseline. Copy these entries to src/.env along with your
# deployment-specific database configuration. Do not put credentials here.
PARTICIPANT_PERMISSIONS_JSON='["PROGRAM_READ","REGISTRATION_CREATE_OWN","REGISTRATION_READ_OWN","REGISTRATION_CANCEL_OWN"]'
PARTICIPANT_ACCESS_SCOPE_JSON='["OWN_PARTICIPANT_RESOURCES"]'
PARTICIPANT_RESPONSIBILITIES_JSON='["VIEW_PROGRAMS","CREATE_OWN_REGISTRATIONS","VIEW_OWN_REGISTRATIONS","CANCEL_OWN_REGISTRATIONS"]'

# Bind to the exact account_identifier of the reserved actor provisioned by
# db/migrations/v1.0_participant-account-schema.sql. Registration fails closed
# until this deployment-specific value is configured; do not create a new actor.
SYSTEM_AUDIT_ACTOR_ACCOUNT_IDENTIFIER=A-dbfbc347c20a11f19ff9320791121194

# Generate a unique deployment secret (at least 32 bytes); never commit it.
SESSION_SECRET=vMyX28lhDlwsv9BFThUC1206mmISxMU0zSOVbhSnXHzKSRvofF8mtK9dBCSz_mD-
# Secure defaults to true. Set false only for local development over HTTP.
SESSION_COOKIE_SECURE=true
